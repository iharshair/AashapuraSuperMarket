{
  "name": "aashapura-super-market",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend storefront for Aashapura Super Market — a local grocery/kirana supermarket in Lohegaon, Pune.",
  "scripts": {
    "predev": "node scripts/build-assets.mjs",
    "dev": "vite",
    "build": "node scripts/build-assets.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "assets": "node scripts/build-assets.mjs",
    "verify:assets": "node scripts/verify-assets.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
